{
  "name": "@ninja/kage-runtime",
  "version": "1.0.0",
  "description": "Kage Runtime — runtime local compartido de Ninja AI Framework",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "start": "node dist/index.js",
    "test": "vitest run src/",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/websocket": "^11.0.1",
    "@ninja/agent-runtime": "workspace:*",
    "@ninja/arsenal-registry": "workspace:*",
    "@ninja/config": "workspace:*",
    "@ninja/contracts": "workspace:*",
    "@ninja/delegation-router": "workspace:*",
    "@ninja/events": "workspace:*",
    "@ninja/flow-matrix": "workspace:*",
    "@ninja/installer": "workspace:*",
    "@ninja/integrations-engram": "workspace:*",
    "@ninja/integrations-fs": "workspace:*",
    "@ninja/integrations-git": "workspace:*",
    "@ninja/integrations-http": "workspace:*",
    "@ninja/integrations-lightrag": "workspace:*",
    "@ninja/integrations-llm": "workspace:*",
    "@ninja/integrations-shell": "workspace:*",
    "@ninja/forge-lab": "workspace:*",
    "@ninja/kage-engine": "workspace:*",
    "@ninja/learning-loop": "workspace:*",
    "@ninja/logging": "workspace:*",
    "@ninja/model-gateway": "workspace:*",
    "@ninja/pulse-center": "workspace:*",
    "@ninja/roster": "workspace:*",
    "@ninja/sentinel": "workspace:*",
    "@ninja/storage": "workspace:*",
    "@ninja/trace-ledger": "workspace:*",
    "@ninja/vault": "workspace:*",
    "@ninja/workbench": "workspace:*",
    "dotenv": "^17.4.1",
    "fastify": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "rimraf": "^6.0.0",
    "tsup": "^8.0.2",
    "tsx": "^4.7.1",
    "typescript": "^5.7.0"
  }
}
