{
  "name": "ninja-ai-framework",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "eslint --config eslint.config.mjs packages/agent-runtime/src packages/arsenal-registry/src packages/integrations-lightrag/src apps/companion-extension/src apps/forge-console/app apps/forge-console/components apps/forge-console/lib",
    "test": "vitest run",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rimraf node_modules .turbo",
    "format": "prettier --write .",
    "runtime:dev": "pnpm --filter @ninja/kage-runtime dev",
    "ninja": "pnpm runtime:dev",
    "console:dev": "pnpm --filter @ninja/forge-console dev",
    "forge": "pnpm console:dev",
    "cli:dev": "pnpm --filter @ninja/dojo-cli dev",
    "dojo": "pnpm --filter @ninja/dojo-cli build && pnpm --filter @ninja/dojo-cli start",
    "db:migrate": "pnpm --filter @ninja/workbench migrate",
    "db:studio": "pnpm --filter @ninja/storage studio",
    "test:e2e": "playwright test",
    "errors:docs": "node scripts/generate-error-docs.mjs",
    "errors:check": "node scripts/generate-error-docs.mjs --check",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "pnpm": {
    "overrides": {
      "fast-uri": ">=3.1.4 <4",
      "ws": "8.21.0",
      "postcss@<8.5.10": ">=8.5.10 <9",
      "find-my-way@<=9.6.0": ">=9.7.0 <10",
      "nanoid@<3.3.16": ">=3.3.16 <4",
      "sharp@<0.35.0": ">=0.35.0 <1",
      "baseline-browser-mapping@<2.11.0": ">=2.11.0 <3"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "@vitest/coverage-v8": "^4.1.5",
    "cross-env": "^10.1.0",
    "eslint": "^9.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.3.0",
    "rimraf": "^6.0.0",
    "turbo": "^2.2.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.4"
  },
  "apps/agent-runtime": {
    "script": "eslint --config ../../eslint.config.mjs packages/agent-runtime"
  }
}
