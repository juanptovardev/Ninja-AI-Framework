# ─────────────────────────────────────────────────────────────────────────────
# Ninja AI Framework — .env.example
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required (boot fails fast if missing or invalid) ─────────────────────────
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-api-key-here
LLM_DEFAULT_MODEL=gpt-4o-mini

# ── Optional (defaults applied if not set) ───────────────────────────────────
# LLM_PROVIDER=openai
# NINJA_RUNTIME_PORT=3141
# LOG_LEVEL=info                    # debug | info | warn | error | silent
# NODE_ENV=development              # development | production | test

# ── LightRAG integration (optional) ──────────────────────────────────────────
# LIGHTRAG_API_URL=http://localhost:9621

# ── LLM failure mode (ADR-0003) ───────────────────────────────────────────────
# NINJA_LLM_FAIL_MODE=strict        # strict (default) | legacy
#   strict: exhausted chain throws LLMError → task.failed (correct behavior)
#   legacy: returns fallback object for backward compat (WP-B6 transition)
