{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@ninja/contracts": ["packages/contracts/src"],
      "@ninja/config": ["packages/config/src"],
      "@ninja/logging": ["packages/logging/src"],
      "@ninja/storage": ["packages/storage/src"],
      "@ninja/events": ["packages/events/src"],
      "@ninja/common-utils": ["packages/common-utils/src"],
      "@ninja/vault": ["packages/vault/src"],
      "@ninja/kage-engine": ["packages/kage-engine/src"],
      "@ninja/flow-matrix": ["packages/flow-matrix/src"],
      "@ninja/agent-runtime": ["packages/agent-runtime/src"],
      "@ninja/arsenal-registry": ["packages/arsenal-registry/src"],
      "@ninja/workbench": ["packages/workbench/src"],
      "@ninja/trace-ledger": ["packages/trace-ledger/src"],
      "@ninja/sentinel": ["packages/sentinel/src"],
      "@ninja/model-gateway": ["packages/model-gateway/src"],
      "@ninja/pulse-center": ["packages/pulse-center/src"],
      "@ninja/learning-loop": ["packages/learning-loop/src"],
      "@ninja/forge-lab": ["packages/forge-lab/src"],
      "@ninja/office-grid": ["packages/office-grid/src"],
      "@ninja/ui-kit": ["packages/ui-kit/src"],
      "@ninja/app-shell": ["packages/app-shell/src"],
      "@ninja/integrations-engram": ["packages/integrations-engram/src"],
      "@ninja/integrations-lightrag": ["packages/integrations-lightrag/src"],
      "@ninja/integrations-llm": ["packages/integrations-llm/src"],
      "@ninja/integrations-shell": ["packages/integrations-shell/src"],
      "@ninja/integrations-git": ["packages/integrations-git/src"],
      "@ninja/integrations-http": ["packages/integrations-http/src"],
      "@ninja/integrations-fs": ["packages/integrations-fs/src"],
      "@ninja/roster": ["packages/roster/src"],
      "@ninja/client-adapters": ["packages/client-adapters/src"],
      "@ninja/delegation-router": ["packages/delegation-router/src"],
      "@ninja/installer": ["packages/installer/src"]
    }
  }
}
