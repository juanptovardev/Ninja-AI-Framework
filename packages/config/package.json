{
  "name": "@ninja/config",
  "version": "1.0.0",
  "description": "Ninja AI Framework Foundation - config",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist node_modules"
  },
  "dependencies": {
    "@ninja/contracts": "workspace:*",
    "@ninja/logging": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.2",
    "typescript": "^5.7.0",
    "rimraf": "^5.0.5"
  }
}
