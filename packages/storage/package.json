{
  "private": true,
  "name": "@ninja/storage",
  "version": "1.0.0",
  "description": "Ninja AI Framework Foundation - storage",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist node_modules"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "@ninja/contracts": "workspace:*",
    "@ninja/logging": "workspace:*"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@ninja/config": "workspace:*",
    "tsup": "^8.0.2",
    "typescript": "^5.7.0"
  }
}
