{
  "name": "@ninja/learning-loop",
  "version": "1.0.0",
  "description": "Ninja AI Framework — Learning Loop. Sistema de aprendizaje desde ejecuciones exitosas.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist node_modules"
  },
  "dependencies": {
    "@ninja/contracts": "workspace:*",
    "@ninja/events": "workspace:*",
    "@ninja/logging": "workspace:*",
    "@ninja/trace-ledger": "workspace:*",
    "@ninja/integrations-engram": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.2",
    "typescript": "^5.7.0",
    "rimraf": "^6.0.0"
  }
}
