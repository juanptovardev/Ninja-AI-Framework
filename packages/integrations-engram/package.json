{
  "private": true,
  "name": "@ninja/integrations-engram",
  "version": "1.0.0",
  "description": "Ninja AI Framework - WARM memory layer for conversation and context persistence",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist node_modules"
  },
  "dependencies": {
    "@ninja/contracts": "workspace:*",
    "@ninja/events": "workspace:*",
    "@ninja/logging": "workspace:*",
    "@ninja/storage": "workspace:*",
    "better-sqlite3": "^12.8.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "tsup": "^8.0.2",
    "typescript": "^5.7.0",
    "rimraf": "^6.0.0"
  }
}
