{
  "name": "@ninja/integrations-lightrag",
  "version": "1.0.0",
  "description": "LightRAG integration for Ninja AI Framework",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --watch --dts",
    "lint": "cross-env ESLINT_USE_FLAT_CONFIG=false eslint src/**/*.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ninja/config": "workspace:*",
    "@ninja/contracts": "workspace:*",
    "@ninja/events": "workspace:*",
    "@ninja/logging": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
